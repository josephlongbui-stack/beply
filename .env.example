# Private, durable server storage; defaults to .data in this project.
# POCKET_DATA_DIR=/absolute/path/to/private/data
# macOS only. Build the default helper with npm run setup:ocr.
# POCKET_OCR_BINARY=/absolute/path/to/beply-ocr
# Enable only behind HTTPS. Local HTTP preview needs false/default.
# POCKET_SECURE_COOKIE=true
# No external AI, supplier, payment or email keys are used.

# Vercel: durable Postgres and private Blob. Set these in Vercel project settings.
# BEPLY_STORAGE=cloud
# DATABASE_URL=postgresql://... (Neon connection string; server-only)
# BLOB_READ_WRITE_TOKEN=... (private Blob store; server-only)
# BEPLY_SIGNUP_CODE=... (random, at least 32 characters; single use owner setup)
